---
import BaseHead from './BaseHead.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { AUTHOR_DESCRIPTION, AUTHOR_NAME } from '../consts';
import type { AirportProfile } from '../data/airport-profiles';

interface Props { profile: AirportProfile; }
const { profile: a } = Astro.props;
const stopped = a.status === 'stopped';
const pageTitle = stopped
  ? `${a.name}机场风险记录｜停止推荐`
  : `${a.name}机场资料｜价格、套餐、客户端与购买前核对`;
const pageDescription = stopped
  ? `${a.name}机场风险记录：来源资料已标记停止推荐，历史套餐不作为当前报价。Siilas 尚无独立测速，不提供评分。`
  : `${a.name}机场资料：套餐摘要${a.priceSummary}；免费试用${a.trial}，通用订阅${a.universalSubscription}。第三方资料最近核对于 ${a.sourceReviewedAt}；Siilas 尚无独立测速。`;
const cautions = a.cautions.split(/[；;]/u).map((item) => item.trim()).filter(Boolean);
const audienceTags = a.audience?.split('、').map((item) => item.trim()).filter(Boolean) ?? [];
const planTables = a.planTables ?? [];
const clientTables = a.clientTables ?? [];
const highlights = a.highlights ?? [];
const trialNote = a.trial === '支持'
  ? '请在商家页面核对领取额度、期限和申请方式，并在账户后台确认实际到账。'
  : a.trial === '不支持'
    ? '来源资料记录为不支持免费试用；短期付费套餐也不等同于免费试用。'
    : '来源资料尚未确认免费试用，请勿在购买前将试用作为既定条件。';
const noExpiryNote = a.noExpiry === '支持'
  ? '购买前逐项核对总流量、有效期、是否自动重置及补流量价格。'
  : a.noExpiry === '不支持'
    ? '如看到年度总量包，应按其到期时间和重置周期比较，不把它当成不限时包。'
    : '来源资料尚未确认是否有真正不限时的总流量包。';
const subscriptionNote = a.universalSubscription === '支持'
  ? '先核实订阅格式、领取方法及常用客户端版本，导入后还需实际连接验证。'
  : '依赖 Clash 等通用客户端的用户，购买前应确认官方指定的接入方式。';
const pageUrl = new URL(`/airport/${a.slug}/`, Astro.site).href;
const authorUrl = new URL('/about/', Astro.site).href;
const pageId = `${pageUrl}#webpage`;
const articleId = `${pageUrl}#article`;
const breadcrumbId = `${pageUrl}#breadcrumb`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': pageId,
      url: pageUrl,
      name: pageTitle,
      description: pageDescription,
      inLanguage: 'zh-CN',
      ...(a.publishedAt ? { datePublished: a.publishedAt } : {}),
      dateModified: a.editorialUpdatedAt,
      mainEntity: { '@id': articleId },
      breadcrumb: { '@id': breadcrumbId },
    },
    {
      '@type': 'Article',
      '@id': articleId,
      url: pageUrl,
      headline: pageTitle,
      description: pageDescription,
      inLanguage: 'zh-CN',
      ...(a.publishedAt ? { datePublished: a.publishedAt } : {}),
      dateModified: a.editorialUpdatedAt,
      author: { '@type': 'Person', '@id': `${authorUrl}#person`, name: AUTHOR_NAME, description: AUTHOR_DESCRIPTION, url: authorUrl },
      publisher: { '@type': 'Organization', name: 'Siilas', url: new URL('/', Astro.site).href },
      mainEntityOfPage: { '@id': pageId },
      isBasedOn: a.sourcePage,
      citation: a.sourcePage,
    },
    {
      '@type': 'BreadcrumbList',
      '@id': breadcrumbId,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首页', item: new URL('/', Astro.site).href },
        { '@type': 'ListItem', position: 2, name: '机场数据库', item: new URL('/airport/', Astro.site).href },
        { '@type': 'ListItem', position: 3, name: `${a.name}机场${stopped ? '风险记录' : '资料'}`, item: pageUrl },
      ],
    },
  ],
};
---
<html lang="zh-CN">
<head><BaseHead title={pageTitle} description={pageDescription} structuredData={structuredData} ogType="article" /></head>
<body><Header /><main class="shell">
  <nav class="breadcrumbs" aria-label="面包屑导航"><a href="/">首页</a><span aria-hidden="true">/</span><a href="/airport/">机场数据库</a><span aria-hidden="true">/</span><span aria-current="page">{a.name}</span></nav>
  <div class="page-head">
    <div class="section-kicker">{stopped ? 'SERVICE RISK · 停止推荐' : `SOURCE REVIEW ${a.sourceReviewedAt} · 尚未实测`}</div>
    <h1>{a.name}机场{stopped ? '风险记录' : '资料'}</h1>
    <p>{stopped
      ? '来源资料已标记停止推荐。下方仅保留风险和出处，历史套餐不作为当前可购买的价格。'
      : `第三方资料最近一次核对记录于 ${a.sourceReviewedAt}，套餐摘要为${a.priceSummary}。各项核对日期见下方来源区；本站尚无独立测速。`}</p>
    <p class="desc">资料整理：<a class="text-link" href="/about/" rel="author">{AUTHOR_NAME}</a></p>
    {a.officialUrl && !stopped && <div class="actions"><a class="button" href={a.officialUrl} target="_blank" rel="nofollow sponsored noopener">官网入口 →</a></div>}
  </div>

  {stopped ? <section class="section">
    <div class="section-head"><div><div class="section-kicker">Risk record</div><h2>停止推荐的原因</h2></div></div>
    <div class="card"><p>{a.cautions}</p><p class="desc">来源文章更新于 {a.sourceUpdatedAt}。该记录不代表 Siilas 对当前服务状态进行了独立复测。</p></div>
  </section> : <>
    <div class="cards profile-overview">
      <section class="card">
        <div class="card-top"><h2>基本信息</h2><strong class="score">资料页</strong></div>
        <p>资料状态：<span class="yes">商业资料已收录，本站尚未实测</span></p>
        <p>客户端：{a.client}</p>
        <p>通用订阅：{a.universalSubscription}</p>
        <p class="desc">最近一项资料核对：{a.sourceReviewedAt} · 建议下次复核：{a.nextSourceReviewAt}</p>
      </section>
      <section class="card">
        <h2>套餐摘要</h2>
        <p>{a.priceSummary}</p>
        <p>免费试用：{a.trial}</p>
        <p>不限时总流量包：{a.noExpiry}</p>
        <p class="desc">各档价格、付款周期和流量以下方套餐表及商家结算页为准。</p>
      </section>
      <section class="card">
        <h2>本站实测状态</h2>
        <p><strong>0</strong> 条 Siilas 独立测速</p>
        <p>速度、稳定性、ChatGPT 与流媒体：待实测</p>
        <p class="desc">暂无原始测速，暂不生成综合评分，也不进入实测排行榜。</p>
      </section>
    </div>

    <section class="section">
      <div class="section-head"><div><div class="section-kicker">Plans</div><h2>套餐与流量</h2></div></div>
      {planTables.length > 0 ? planTables.map((table) => <div class="profile-table-block">
        <h3>{table.title}</h3>
        <div class="table-scroll"><table class="data-table"><caption class="sr-only">{table.title}</caption><thead><tr>{table.columns.map((column) => <th scope="col">{column}</th>)}</tr></thead><tbody>{table.rows.map((row) => <tr>{row.map((value) => <td>{value}</td>)}</tr>)}</tbody></table></div>
        {table.truncated && <p class="desc">此表仅展示部分内容；原文共 {table.sourceRowCount} 行、{table.sourceColumnCount} 列，请查看资料来源页。</p>}
      </div>) : <div class="card"><p>{a.priceSummary}</p><p class="desc">来源资料暂无可直接整理的逐档套餐表，请到原文和商家结算页核对。</p></div>}
      <p class="desc">以上是来源资料标注日期的价格与额度。付款周期、流量重置和实际结算金额以商家页面为准。</p>
    </section>

    <section class="section">
      <div class="section-head"><div><div class="section-kicker">Service terms</div><h2>试用与使用方式</h2></div></div>
      <div class="cards profile-cards profile-detail-cards">
        <section class="card"><h3>免费试用</h3><p>{a.trial}</p><p class="desc">{trialNote}</p></section>
        <section class="card"><h3>订阅与客户端</h3><p>{a.client}</p><p>通用订阅：{a.universalSubscription}</p><p class="desc">{subscriptionNote}</p></section>
        <section class="card"><h3>不限时流量</h3><p>{a.noExpiry}</p><p class="desc">{noExpiryNote}</p></section>
      </div>
    </section>
    <section class="section">
      <div class="section-head"><div><div class="section-kicker">Clients and setup</div><h2>客户端与使用条件</h2></div></div>
      <div class="card"><p>资料记录的客户端：{a.client}；通用订阅：{a.universalSubscription}。</p><p class="desc">下表仅整理来源页列出的教程与导入方式；安装步骤不代表本站验证了所有设备和网络。</p></div>
      {clientTables.map((table) => <div class="profile-table-block">
        <h3>{table.title}</h3>
        <div class="table-scroll"><table class="data-table"><caption class="sr-only">{table.title}</caption><thead><tr>{table.columns.map((column) => <th scope="col">{column}</th>)}</tr></thead><tbody>{table.rows.map((row) => <tr>{row.map((value) => <td>{value}</td>)}</tr>)}</tbody></table></div>
        {table.truncated && <p class="desc">此表仅展示部分内容；原文共 {table.sourceRowCount} 行、{table.sourceColumnCount} 列，请查看资料来源页。</p>}
      </div>)}
      {clientTables.length === 0 && <p class="desc">来源原文没有独立的分平台教程表，具体安装路径请查看资料来源链接及商家当前文档。</p>}
    </section>

    <section class="section">
      <div class="section-head"><div><div class="section-kicker">Choosing a service</div><h2>适用方向与购买前核对</h2></div></div>
      <div class="cards profile-cards profile-detail-cards">
        <section class="card"><h3>资料分类</h3><ul>{audienceTags.map((item) => <li>{item}</li>)}</ul><p class="desc">这些是来源资料的选购分类，不代表 Siilas 已验证对应应用或线路表现。</p></section>
        <section class="card"><h3>这家的具体条件</h3><ul>{highlights.map((item) => <li>{item}</li>)}</ul></section>
        <section class="card"><h3>购买前核对</h3><ul>{cautions.map((item) => <li>{item}</li>)}</ul></section>
      </div>
      <p class="desc">以上为标注日期的商业资料整理；速度和可用性仍需要独立测速。</p>
    </section>
  </>}

  {!stopped && <>
    <section class="section raw-records">
      <div class="section-head"><div><div class="section-kicker">Raw records</div><h2>原始测速记录</h2></div><a class="text-link" href="/test/">浏览测速中心 →</a></div>
      <div class="card"><p><strong>暂无{a.name}的 Siilas 原始测速记录。</strong></p><p class="desc">其他站点的历史截图和商家宣传不会计入本站评分。收到可追溯的节点、日期、结果链接或截图后，再按<a class="text-link" href="/methodology/">统一方法</a>录入。</p></div>
    </section>
  </>}
  <section class="section">
    <div class="section-head"><div><div class="section-kicker">Source notes</div><h2>{stopped ? '风险资料来源与日期' : '商业资料来源与日期'}</h2></div></div>
    <div class="card">
      <p>{stopped ? '风险资料来源：' : '商业资料来源：'}<a class="text-link" href={a.sourcePage} target="_blank" rel="noopener noreferrer">yp7.net 的{a.name}资料页 →</a></p>
      <p>{stopped ? '风险依据复核时间：' : '最近一项资料核对：'}{a.sourceReviewedAt} · 下次建议复核：{a.nextSourceReviewAt}</p>
      <p class="desc">来源文章编辑日期：{a.sourceUpdatedAt}。文章编辑不等于套餐或客户端重新核对。</p>
      <details><summary>查看分项核对日期</summary><p>{a.sourceReviewNote}</p></details>
      {a.officialLinkNote && <p class="desc">官网入口核对：{a.officialLinkNote}</p>}
      {stopped
        ? <p class="desc">风险信息仅反映来源页标注日期的记录；该页不提供购买入口或当前服务可用性判断。</p>
        : <p class="desc">部分官网入口可能含推荐码，相关关系见<a class="text-link" href="/disclosure/">推广披露</a>。页面信息仅反映上述日期的来源资料，购买前请重新核对商家公告和结算页。</p>}
    </div>
  </section>
</main><Footer /></body>
</html>
