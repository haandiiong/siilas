---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { SITE_TITLE } from '../consts';
interface Props { title?: string; description: string; noindex?: boolean }
const { title, description, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : `${SITE_TITLE} · 机场评测数据库`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: SITE_TITLE,
	url: Astro.site,
	description,
	inLanguage: 'zh-CN',
};
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#07110f" />
<link rel="icon" href="/favicon.svg" />
<Font cssVariable="--font-atkinson" preload />
<link rel="canonical" href={canonicalURL} />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large'} />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
