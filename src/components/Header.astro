---
const path = Astro.url.pathname;
const links = [['/airport/', '机场库'], ['/rank/', '排行榜'], ['/test/', '测速中心'], ['/tutorial/', '教程']];
---
<header class="site-header">
  <nav class="nav shell" aria-label="主导航">
    <a class="brand" href="/" aria-label="Siilas 首页"><span class="brand-mark">S</span><span>SIILAS</span></a>
    <div class="nav-links">
      {links.map(([href, label]) => <a class:list={{active: path.startsWith(href)}} href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>)}
    </div>
    <a class:list={['nav-cta', { active: path.startsWith('/methodology/') }]} href="/methodology/" aria-current={path.startsWith('/methodology/') ? 'page' : undefined}>测试方法</a>
    <details class="mobile-menu">
      <summary aria-label="打开主导航">菜单</summary>
      <div class="mobile-menu-panel">
        {links.map(([href, label]) => <a class:list={{active: path.startsWith(href)}} href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>)}
        <a class:list={{active: path.startsWith('/methodology/')}} href="/methodology/" aria-current={path.startsWith('/methodology/') ? 'page' : undefined}>测试方法</a>
      </div>
    </details>
  </nav>
</header>
