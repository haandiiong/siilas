---
import BaseHead from './BaseHead.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { AUTHOR_DESCRIPTION, AUTHOR_NAME, TEST_CLIENTS, TEST_DEVICE, TEST_NETWORK } from '../consts';
import { getMaxDownload } from '../data/airport-data';
import type { Airport } from '../data/airport-data';
import { getLatestRegionTests, getTestEvidenceLinks, getTestRecordDetails, sortTestsNewestFirst } from '../data/test-record-presentation';
interface Props { airport: Airport; }
const { airport: a } = Astro.props;
const testCount = a.tests?.length ?? 0;
const verifiedTestCount = a.verifiedTestCount;
const nodeSnapshotCount = a.nodeSnapshots?.length ?? 0;
const serviceIncidentCount = a.serviceIncidents?.length ?? 0;
const operationalObservationCount = nodeSnapshotCount + serviceIncidentCount;
const scoringSamples = sortTestsNewestFirst(a.tests ?? []);
const latestRegionTests = getLatestRegionTests(scoringSamples);
const nodeEvidenceImages = [...new Set([
  ...(a.nodeEvidenceImages ?? []),
  ...(a.nodeSnapshots ?? []).flatMap((snapshot) => snapshot.evidenceImages),
])];
const sampleDates = scoringSamples.map((sample) => sample.testedAt).sort();
const sampleStartDate = sampleDates[0] ?? null;
const sampleEndDate = sampleDates.at(-1) ?? null;
const latestSample = scoringSamples[0];
const testedRegions = [
  { name: '新加坡', pattern: /新加坡/u },
  { name: '香港', pattern: /香港/u },
  { name: '日本', pattern: /日本/u },
  { name: '美国', pattern: /美国/u },
].filter(({ pattern }) => scoringSamples.some((sample) => pattern.test(sample.node))).map(({ name }) => name);
const coverageLabel = testedRegions.length ? testedRegions.join('、') : '常用地区节点';
const pageTitle = `${a.name}机场评测｜价格、套餐、节点速度与稳定性`;
const pageDescription = `${a.name}机场实测评测：最低套餐 ${a.entryPlan.price}、${a.entryPlan.traffic}，收录 ${verifiedTestCount} 条已验证测速，覆盖${coverageLabel}，包含套餐价格、节点速度、稳定性、ChatGPT 与流媒体体验${a.officialClientOnly ? '；不支持通用订阅' : ''}；商业资料复核于 ${a.commercialReviewedAt}。`;
const scoreInputsUpdatedAt = a.rankingDataModifiedAt;
const datasetModifiedAt = [scoreInputsUpdatedAt, a.editorialUpdatedAt].filter((date): date is string => Boolean(date)).sort().at(-1);
const pageUrl = new URL(`/airport/${a.slug}/`, Astro.site).href;
const authorUrl = new URL('/about/', Astro.site).href;
const siteUrl = new URL('/', Astro.site).href;
const webpageId = `${pageUrl}#webpage`;
const articleId = `${pageUrl}#article`;
const datasetId = `${pageUrl}#dataset`;
const breadcrumbId = `${pageUrl}#breadcrumb`;
const airportStructuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': webpageId,
      url: pageUrl,
      name: pageTitle,
      description: pageDescription,
      inLanguage: 'zh-CN',
      dateModified: a.pageModifiedAt,
      mainEntity: [{ '@id': articleId }, { '@id': datasetId }],
      breadcrumb: { '@id': breadcrumbId },
    },
    {
      '@type': 'Article',
      '@id': articleId,
      url: pageUrl,
      headline: pageTitle,
      description: pageDescription,
      inLanguage: 'zh-CN',
      dateModified: a.pageModifiedAt,
      author: {
        '@type': 'Person',
        '@id': `${authorUrl}#person`,
        name: AUTHOR_NAME,
        description: AUTHOR_DESCRIPTION,
        url: authorUrl,
      },
      publisher: {
        '@type': 'Organization',
        name: 'Siilas',
        url: siteUrl,
      },
      mainEntityOfPage: { '@id': webpageId },
      isBasedOn: a.sourcePage ? [{ '@id': datasetId }, a.sourcePage] : { '@id': datasetId },
      ...(a.sourcePage ? { citation: a.sourcePage } : {}),
      isPartOf: { '@id': webpageId },
    },
    {
      '@type': 'Dataset',
      '@id': datasetId,
      name: `${a.name}机场节点实测数据`,
      description: `siilas 使用${TEST_NETWORK}、${TEST_DEVICE}和${a.testClient ?? TEST_CLIENTS}持续测试${a.name}的常用地区节点，记录速度、Speedtest 空闲延迟、ChatGPT 与流媒体体验。数据包含 ${verifiedTestCount} 条已验证测速。`,
      url: pageUrl,
      creator: {
        '@type': 'Person',
        '@id': `${authorUrl}#person`,
        name: AUTHOR_NAME,
        description: AUTHOR_DESCRIPTION,
        url: authorUrl,
      },
      publisher: {
        '@type': 'Organization',
        name: 'Siilas',
        url: siteUrl,
      },
      dateModified: datasetModifiedAt,
      ...(sampleStartDate && sampleEndDate ? { temporalCoverage: `${sampleStartDate}/${sampleEndDate}` } : {}),
      measurementTechnique: `${TEST_NETWORK}、${TEST_DEVICE}、${a.testClient ?? TEST_CLIENTS}、Speedtest 实测、ChatGPT 与流媒体定性体验记录`,
      variableMeasured: [
        '下载速度 Mbps',
        '上传速度 Mbps',
        'Speedtest 空闲延迟 ms',
        'ChatGPT 使用体验状态',
        '流媒体使用体验状态',
      ],
      ...(testedRegions.length ? { spatialCoverage: testedRegions } : {}),
      additionalProperty: [
        {
          '@type': 'PropertyValue',
          name: '参与评分计算的记录总数',
          value: testCount,
          unitText: '条',
        },
        {
          '@type': 'PropertyValue',
          name: '已验证测速样本数量',
          value: verifiedTestCount,
          unitText: '条',
        },
        {
          '@type': 'PropertyValue',
          name: '原始测速样本数量',
          value: testCount,
          unitText: '条',
        },
        {
          '@type': 'PropertyValue',
          name: '覆盖的不同测试日期',
          value: a.dataDays,
          unitText: '天',
        },
        {
          '@type': 'PropertyValue',
          name: '评分依据最近日期',
          value: scoreInputsUpdatedAt,
        },
        {
          '@type': 'PropertyValue',
          name: '最近实际测试日期',
          value: a.latestTestAt ?? '待测试',
        },
        {
          '@type': 'PropertyValue',
          name: '商业资料复核日期',
          value: a.commercialReviewedAt,
        },
        ...(a.clientSupportVerifiedAt ? [{
          '@type': 'PropertyValue',
          name: '客户端支持确认日期',
          value: a.clientSupportVerifiedAt,
        }] : []),
        {
          '@type': 'PropertyValue',
          name: '性价比计分套餐',
          value: `${a.scoringPlan.name}，${a.scoringPlan.priceLabel}，${a.scoringPlan.trafficLabel}`,
        },
      ],
      isAccessibleForFree: true,
      keywords: [`${a.name}机场`, '机场测速', '机场稳定性', 'ChatGPT 节点', '流媒体测试'],
      version: datasetModifiedAt,
    },
    {
      '@type': 'BreadcrumbList',
      '@id': breadcrumbId,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: '首页',
          item: siteUrl,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: '机场数据库',
          item: new URL('/airport/', Astro.site).href,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: `${a.name}机场评测`,
          item: pageUrl,
        },
      ],
    },
  ],
};
const monitoringCopy = a.dataDays === 0
  ? '尚无实测样本，暂不参与正式排名。'
	: a.rankingEligible
	  ? '评分来自已验证测速，新增有效记录后会自动更新。'
	  : `当前已有 ${a.dataDays} 个测试日期；新加坡、香港、日本和美国每个地区均达到 3 个不同测试日期后即可参与评分。`;
const testHeading = a.dataDays === 0 ? '等待首次实测' : `已有样本 ${a.dataDays} 天`;
const withoutTrailingPunctuation = (value: string) => value.replace(/[。；;，,\s]+$/u, '');
const formatFoundedAt = (value: string) => {
  const [year, month, day] = value.split('-');
  if (!month) return `${year} 年`;
  return day ? `${year} 年 ${Number(month)} 月 ${Number(day)} 日` : `${year} 年 ${Number(month)} 月`;
};
---
<html lang="zh-CN">
<head><BaseHead title={pageTitle} description={pageDescription} structuredData={airportStructuredData} ogType="article" /></head>
<body><Header /><main class="shell">
  <nav class="breadcrumbs" aria-label="面包屑导航"><a href="/">首页</a><span aria-hidden="true">/</span><a href="/airport/">机场数据库</a><span aria-hidden="true">/</span><span aria-current="page">{a.name}</span></nav>
  <div class="page-head">
    <div class="section-kicker">SAMPLE DAYS {a.dataDays ?? '—'} · TESTED {a.latestTestAt ?? '—'}</div>
    <h1>{a.name}机场评测</h1><p>{a.summary}</p>
    <p class="desc">测试与整理：<a class="text-link" href="/about/" rel="author">{AUTHOR_NAME}</a> · {AUTHOR_DESCRIPTION}</p>
    {a.website && <div class="actions"><a class="button" href={a.website} target="_blank" rel="nofollow sponsored noopener">官网入口 →</a></div>}
  </div>
  <div class="cards">
	<section class="card"><div class="card-top"><h2>基本信息</h2><strong class="score">{a.score ?? '样本不足'}</strong></div>
      <p>数据状态：<span class="yes">{a.status}</span></p>
      {a.serviceStatus && <p>当前服务状态：<strong>{a.serviceStatus}</strong>{a.serviceStatusUpdated && <small>（更新 {a.serviceStatusUpdated}）</small>}</p>}
      {a.foundedAt && <p>成立时间：{formatFoundedAt(a.foundedAt)}</p>}
      {a.testClient && <p>测试客户端：{a.testClient}</p>}
      {a.officialClientOnly && <p><strong>客户端兼容性：不支持通用订阅，按官网指定客户端流程使用</strong>{a.clientSupportVerifiedAt && <small>（确认于 {a.clientSupportVerifiedAt}）</small>}</p>}
      {a.platforms && <p>支持平台：{a.platforms.join('、')}</p>}{a.deviceLimit && <p>设备限制：{a.deviceLimit}</p>}
      <p class="desc">{monitoringCopy}</p>
    </section>
    <section class="card"><h2>最低套餐</h2><p>{a.entryPlan.price} · {a.entryPlan.traffic}</p><p>协议：{a.protocol}</p>
      <p class="desc">性价比计分套餐：{a.scoringPlan.name} · {a.scoringPlan.priceLabel} · {a.scoringPlan.trafficLabel}</p>
      {a.couponCode && <p>{a.couponLabel ?? '优惠码'}：<strong class="score">{a.couponCode}</strong></p>}{a.registrationOffer && <p class="desc">{a.registrationOffer}</p>}{a.offerEvidenceImages && <p class="desc">优惠截图证据：{a.offerEvidenceImages.map((image, index) => <><a class="text-link" href={image} target="_blank" rel="noopener">截图 {index + 1} →</a>{index < a.offerEvidenceImages!.length - 1 ? ' · ' : ''}</>)}</p>}
      <p class="desc">商业资料复核：{a.commercialReviewedAt} · 下次复核：{a.nextCommercialReviewAt}</p>
    </section>
    <section class="card"><h2>{testHeading}</h2>{testCount > 0 ? <>
	      <p><strong>{verifiedTestCount}</strong> 条已验证测速样本</p>
	      <p class="desc">{testCount} 条原始测速全部参与评分</p>
	      <p>最高下载 <strong>{getMaxDownload(a)} Mbps</strong></p>
      <p class="desc">各地区最新有效记录的体验见下方，不同日期与节点分别展示。</p>
      <p class="desc">已实测体验分（百分制）：ChatGPT {a.experienceScores.chatgpt ?? '待测试'} · 流媒体 {a.experienceScores.streaming ?? '待测试'}</p>
      {a.scoreBreakdown && <p class="desc">综合评分构成（百分制）：稳定性 {a.scoreBreakdown.stability} · 速度 {a.scoreBreakdown.speed} · 性价比 {a.scoreBreakdown.value}</p>}
	  <p class="desc">{a.rankingEligible ? '当前四个常用地区均有至少 3 个不同测试日期，已计算综合评分。' : '至少一个常用地区少于 3 个不同测试日期，样本不足，暂不计算稳定性和综合评分。'}</p>
	      {operationalObservationCount > 0 && <p class="desc">另有 {operationalObservationCount} 条节点或服务观察，仅作运行记录，不计入评分。</p>}
	    </> : <><p>尚未录入测速记录</p>{operationalObservationCount > 0 && <p>{operationalObservationCount} 条节点或服务观察</p>}<p class="desc">运行观察不计入评分。</p></>}</section>
  </div>
  {testCount > 0 && <section class="section">
    <div class="section-head"><div><div class="section-kicker">Latest regional experience</div><h2>各地区最新实测体验</h2></div></div>
    <div class="table-scroll"><table class="data-table"><caption class="sr-only">{a.name}各地区最新有效测速的使用体验</caption><thead><tr><th>地区 / 节点</th><th>测试时间</th><th>ChatGPT</th><th>流媒体</th><th>测速证据</th></tr></thead><tbody>{latestRegionTests.map(({ region, test }) => <tr><td class="airport-name">{region}{test && <small>{test.node}</small>}</td><td>{test ? <>{test.testedAt}<br />{test.time ?? '时间未记录'}</> : '待测试'}</td><td>{test?.chatgpt ?? '待测试'}</td><td>{test?.streaming ?? '待测试'}</td><td>{test?.resultUrl && <a class="text-link" href={test.resultUrl} target="_blank" rel="noopener nofollow">Speedtest →</a>}{test && getTestEvidenceLinks(test).map(({ label, path }) => <small><a class="text-link" href={path} target="_blank" rel="noopener">{label} →</a></small>)}{!test && '待补充'}</td></tr>)}</tbody></table></div>
    <p class="desc">每个地区采用最近一条保留结果链接或截图的有效记录；体验为当次测试者提交的定性状态。</p>
  </section>}
  <section class="section">
    <div class="section-head"><div><div class="section-kicker">Score provenance</div><h2>评分依据</h2></div><a class="text-link" href="/methodology/">查看完整评分规则 →</a></div>
    <div class="cards">
      <section class="card"><h2>样本与范围</h2><p><strong>{verifiedTestCount}</strong> 条已验证样本</p><p>覆盖 {a.dataDays} 个不同测试日期，全部参与评分。</p><p class="desc">每条样本均保留 Speedtest 结果链接或截图。</p></section>
      <section class="card"><h2>数据周期</h2><p>{sampleStartDate === sampleEndDate ? sampleStartDate : `${sampleStartDate} 至 ${sampleEndDate}`}</p><p class="desc">最新测速：{latestSample ? `${latestSample.testedAt}${latestSample.time ? ` ${latestSample.time}` : ''}` : '待测试'}</p><p class="desc">评分依据最近日期：{scoreInputsUpdatedAt}（测速与商业资料）</p><p class="desc">商业资料复核：{a.commercialReviewedAt}</p><p class="desc">下次商业复核：{a.nextCommercialReviewAt}</p></section>
      <section class="card"><h2>实测覆盖</h2><p>{testedRegions.length ? testedRegions.join('、') : '常用地区节点待补充'}</p><p class="desc">测试环境：{TEST_NETWORK} · {TEST_DEVICE}</p><p class="desc">测试客户端：{a.testClient ?? TEST_CLIENTS}</p></section>
    </div>
    {a.scoreBreakdown ? <div class="card" style="margin-top:20px">
      <div class="table-scroll"><table class="data-table"><caption class="sr-only">{a.name}机场综合评分构成</caption><thead><tr><th>评分项目</th><th>分数</th><th>权重</th><th>评分来源</th></tr></thead><tbody>
        <tr><td>稳定性</td><td class="score">{a.scoreBreakdown.stability}</td><td>40%</td><td>同地区节点跨日期下载、上传波动</td></tr>
        <tr><td>速度</td><td class="score">{a.scoreBreakdown.speed}</td><td>25%</td><td>各地区每日代表下载速度相对 1000M 宽带的利用率，地区等权</td></tr>
        <tr><td>ChatGPT</td><td class="score">{a.scoreBreakdown.chatgpt}</td><td>15%</td><td>同地区同日的定性体验先汇总，再按地区等权</td></tr>
        <tr><td>流媒体</td><td class="score">{a.scoreBreakdown.streaming}</td><td>10%</td><td>同地区同日的定性体验先汇总，再按地区等权</td></tr>
        <tr><td>性价比</td><td class="score">{a.scoreBreakdown.value}</td><td>10%</td><td>计分套餐价格与周期总流量</td></tr>
      </tbody></table></div>
      <p><strong>综合评分：{a.score} / 10</strong></p>
      <p class="desc">本站分数是基于已验证测速自动计算的编辑评分，不是用户投票或第三方评级。新增有效记录后，分数会按相同规则重新计算。</p>
    </div> : <div class="card" style="margin-top:20px">
	  <p><strong>评分状态：样本不足</strong></p>
	  <p>当前累计 {a.dataDays} 个不同测试日期、{verifiedTestCount} 条已验证样本。新加坡、香港、日本和美国每个地区均达到 3 个不同测试日期后才计算综合评分。</p>
      <p class="desc">当前仅显示已有实测的体验子项：ChatGPT {a.experienceScores.chatgpt ?? '待测试'} · 流媒体 {a.experienceScores.streaming ?? '待测试'}。未达到门槛前，不生成稳定性和综合评分。</p>
      <p class="desc">本站分数是基于已验证测速自动计算的编辑评分，不是用户投票或第三方评级。</p>
    </div>}
  </section>
  {(a.trial || a.universalSubscription || a.noExpiry) && <section class="section"><div class="section-head"><div><div class="section-kicker">Service terms</div><h2>试用与使用方式</h2></div></div><div class="cards">
    <section class="card"><h2>免费试用</h2><p>{a.trial ?? '待复核'}</p></section>
    <section class="card"><h2>订阅方式</h2><p>{a.universalSubscription ?? '待复核'}</p>{a.platforms && <p class="desc">{a.platforms.join('、')}</p>}{a.clientNotes && <p class="desc">{a.clientNotes}</p>}{a.bandwidthPolicy && <p class="desc">{a.bandwidthPolicy}</p>}</section>
    <section class="card"><h2>不限时流量</h2><p>{a.noExpiry ?? '待复核'}</p>{a.paymentMethods && <p class="desc">支付：{a.paymentMethods.join('、')}</p>}</section>
  </div></section>}

  {a.selectionGuide && <section class="section"><div class="section-head"><div><div class="section-kicker">Choosing a service</div><h2>适合人群与购买前核对</h2></div></div><div class="cards">
    <section class="card"><h2>可以考虑</h2><ul>{a.selectionGuide.goodFor.map((item) => <li>{item}</li>)}</ul></section>
    <section class="card"><h2>购买前核对</h2><ul>{a.selectionGuide.checkBeforeBuying.map((item) => <li>{item}</li>)}</ul></section>
  </div><p class="desc">以上依据已记录的套餐和客户端条件整理。速度与可用性请按本站对应的测速日期和节点判断。</p></section>}

  {a.nodeSnapshots && <section class="section"><div class="section-head"><div><div class="section-kicker">Node availability</div><h2>节点在线快照</h2></div></div><div class="table-scroll"><table class="data-table"><caption class="sr-only">{a.name}机场节点在线快照</caption><thead><tr><th>采集时间</th><th>节点总数</th><th>可达</th><th>超时</th><th>高延迟</th><th>异常节点</th><th>截图证据</th></tr></thead><tbody>{a.nodeSnapshots.map(snapshot => <tr><td>{snapshot.capturedAt}<br/>{snapshot.time}</td><td>{snapshot.total}</td><td class="yes">{snapshot.reachable}</td><td>{snapshot.timeout}</td><td>{snapshot.highLatency}<small>{snapshot.latencyRange}</small></td><td><small>超时：{snapshot.timeoutNodes.length ? snapshot.timeoutNodes.join('、') : '无'}</small><small>高延迟：{snapshot.highLatencyNodes.length ? snapshot.highLatencyNodes.join('、') : '无'}</small><small>当前选择：{snapshot.selectedNode}</small></td><td>{snapshot.evidenceImages.map((image, index) => <a class="text-link" href={image} target="_blank" rel="noopener">截图 {index + 1} →<br/></a>)}</td></tr>)}</tbody></table></div><p class="desc">节点状态是指定时刻的客户端快照，仅反映当时可达性与客户端显示延迟，不等同于长期在线率。</p></section>}
  {a.serviceIncidents && <section class="section"><div class="section-head"><div><div class="section-kicker">Service incidents</div><h2>服务异常记录</h2></div></div><div class="table-scroll"><table class="data-table"><caption class="sr-only">{a.name}机场服务异常记录</caption><thead><tr><th>观察时间</th><th>状态</th><th>测速</th><th>ChatGPT</th><th>流媒体</th></tr></thead><tbody>{a.serviceIncidents.map(incident => <tr><td>{incident.observedAt}<br/>{incident.time}</td><td>{incident.status}</td><td>{incident.speedtest}</td><td>{incident.chatgpt}</td><td>{incident.streaming}<small>{incident.note}</small></td></tr>)}</tbody></table></div></section>}
  {a.plans && <section class="section"><div class="section-head"><div><div class="section-kicker">Plans</div><h2>套餐与流量</h2></div></div><div class="table-scroll"><table class="data-table"><caption class="sr-only">{a.name}机场月付及周期套餐</caption><thead><tr><th>套餐</th><th>价格</th><th>流量</th><th>主要规则</th></tr></thead><tbody>{a.plans.map(p => <tr><td class="airport-name">{p.name}</td><td>{p.price}</td><td>{p.traffic}</td><td>{p.details?.join('；') ?? '以套餐页实时说明为准'}</td></tr>)}</tbody></table></div>{a.billingPolicy && <p class="desc">付费周期：{a.billingPolicy}</p>}{a.planEvidenceImages && <p class="desc">{a.planEvidenceLabel ?? '套餐截图证据'}：{a.planEvidenceImages.map((image, index) => <><a class="text-link" href={image} target="_blank" rel="noopener">截图 {index + 1} →</a>{index < a.planEvidenceImages!.length - 1 ? ' · ' : ''}</>)}</p>}</section>}
  {a.noExpiryPlans && <section class="section"><div class="section-head"><div><div class="section-kicker">No-expiry plans</div><h2>不限时流量套餐</h2></div></div><div class="table-scroll"><table class="data-table"><caption class="sr-only">{a.name}机场不限时流量套餐</caption><thead><tr><th>套餐</th><th>价格</th><th>流量与有效期</th><th>主要规则</th></tr></thead><tbody>{a.noExpiryPlans.map(p => <tr><td class="airport-name">{p.name}</td><td>{p.price}</td><td>{p.traffic}</td><td>{p.details?.join('；') ?? '以套餐页实时说明为准'}</td></tr>)}</tbody></table></div>{a.billingPolicy && <p class="desc">套餐规则：{a.billingPolicy}</p>}{a.planEvidenceImages && <p class="desc">{a.planEvidenceLabel ?? '套餐截图证据'}：{a.planEvidenceImages.map((image, index) => <><a class="text-link" href={image} target="_blank" rel="noopener">截图 {index + 1} →</a>{index < a.planEvidenceImages!.length - 1 ? ' · ' : ''}</>)}</p>}</section>}
  {a.dailyPlans && <section class="section"><div class="section-head"><div><div class="section-kicker">Daily quota plans</div><h2>每日独立流量套餐</h2></div></div><div class="table-scroll"><table class="data-table"><caption class="sr-only">{a.name}机场每日独立流量套餐</caption><thead><tr><th>套餐</th><th>价格</th><th>有效期</th><th>流量规则</th></tr></thead><tbody>{a.dailyPlans.map(p => <tr><td class="airport-name">{p.name}</td><td>{p.price}</td><td>{p.duration}</td><td>{p.traffic}</td></tr>)}</tbody></table></div></section>}
  {a.addOns && <section class="section"><div class="section-head"><div><div class="section-kicker">Traffic add-ons</div><h2>流量加油包</h2></div></div><div class="table-scroll"><table class="data-table"><caption class="sr-only">{a.name}机场流量加油包</caption><thead><tr><th>加油包</th><th>价格</th><th>增加流量</th><th>使用条件</th></tr></thead><tbody>{a.addOns.map(item => <tr><td class="airport-name">{item.name}</td><td>{item.price}</td><td>{item.traffic}</td><td>{item.condition}</td></tr>)}</tbody></table></div></section>}
  {a.regions && <section class="section"><div class="section-head"><div><div class="section-kicker">Network</div><h2>节点与使用条件</h2></div></div><div class="cards">
	    <section class="card"><h2>节点覆盖</h2>{a.nodeCount ? <p>{a.nodeCount} 个节点</p> : <p>节点数量待复核</p>}<p>{a.regions.join('、')}</p>{a.onlineSnapshot && <p class="desc">{withoutTrailingPunctuation(a.onlineSnapshot)}。这是带日期的后台快照，不代表长期在线率。</p>}{a.regionsNote && <p class="desc">{a.regionsNote}</p>}{nodeEvidenceImages.length > 0 && <p class="desc">节点截图证据：{nodeEvidenceImages.map((image, index) => <><a class="text-link" href={image} target="_blank" rel="noopener">截图 {index + 1} →</a>{index < nodeEvidenceImages.length - 1 ? ' · ' : ''}</>)}</p>}</section>
    <section class="card"><h2>线路与订阅</h2><p>{a.lineTypes?.join(' / ') ?? '线路待复核'} · {a.protocol}</p>{a.universalSubscription && <p>{a.universalSubscription}</p>}{a.bandwidthPolicy && <p class="desc">{a.bandwidthPolicy}</p>}</section>
    <section class="card"><h2>支付与售后</h2><p>{a.paymentMethods?.join('、') ?? '支付方式待复核'}</p>{a.refundPolicy && <p class="desc">{a.refundPolicy}</p>}</section>
  </div></section>}
  {testCount > 0 && <section class="section raw-records" data-test-pagination>
    <div class="section-head"><div><div class="section-kicker">Raw records</div><h2>原始测速记录</h2></div><a class="text-link" href="/test/">浏览全部机场测速 →</a></div>
    <p class="desc">按测试时间由新到旧排列，时间均为北京时间。</p>
    <div class="table-scroll"><table class="data-table"><caption class="sr-only">{a.name}机场原始测速记录</caption><thead><tr><th>时间</th><th>节点</th><th>下载</th><th>上传</th><th>ChatGPT</th><th>流媒体</th><th>详情</th></tr></thead><tbody>{scoringSamples.map(t => <tr data-page-row>
      <td>{t.testedAt}<br/>{t.time ?? '时间未记录'}</td><td class="airport-name">{t.node}</td><td>{t.downloadMbps} Mbps</td><td>{t.uploadMbps.toFixed(2)} Mbps</td><td>{t.chatgpt}</td><td>{t.streaming}</td>
      <td>{t.resultUrl && <a class="text-link" href={t.resultUrl} target="_blank" rel="noopener nofollow">Speedtest →</a>}{getTestEvidenceLinks(t).map(({ label, path }) => <small><a class="text-link" href={path} target="_blank" rel="noopener">{label} →</a></small>)}
        <details class="test-record-details"><summary>记录详情</summary><dl>{getTestRecordDetails(t).map(({ label, value }) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl></details>
      </td>
    </tr>)}</tbody></table></div>
    <nav class="table-pagination" data-pagination-controls hidden aria-label="原始测速记录分页">
      <button type="button" data-page-action="previous">上一页</button>
      <span class="page-numbers" data-page-numbers></span>
      <button type="button" data-page-action="next">下一页</button>
      <span class="page-summary" data-page-summary aria-live="polite"></span>
    </nav>
  </section>}
  {a.sourcePage && <section class="section"><div class="section-head"><div><div class="section-kicker">Source notes</div><h2>商业资料来源与日期</h2></div></div><div class="card"><p>商业资料来源：<a class="text-link" href={a.sourcePage} target="_blank" rel="noopener noreferrer">yp7.net 的{a.name}资料页 →</a></p><p class="desc">商业资料由 yp7.net 收集复核，商业资料复核日期为 {a.commercialReviewedAt}；分项核对日期见下方说明。</p>{a.sourceReviewNote && <p>{a.sourceReviewNote}</p>}<p class="desc">节点测速和使用体验由 Siilas 实测。商业资料核对与页面整理不代表新增测速；性能结论请以上方原始记录的测试日期为准。</p></div></section>}
</main><Footer /></body></html>

<style>
  .data-table td > small { display: block; margin-top: 4px; }
  .test-record-details { min-width: 150px; margin-top: 8px; }
  .test-record-details summary { color: var(--lime); cursor: pointer; white-space: nowrap; }
  .test-record-details dl { margin: 12px 0 0; font-size: 13px; }
  .test-record-details dl > div { padding: 6px 0; border-top: 1px solid var(--line); }
  .test-record-details dt { color: var(--muted); }
  .test-record-details dd { margin: 3px 0 0; overflow-wrap: anywhere; }
</style>

<script>
  const pageSize = 5;

  document.querySelectorAll<HTMLElement>('[data-test-pagination]').forEach((section) => {
    const rows = Array.from(section.querySelectorAll<HTMLTableRowElement>('[data-page-row]'));
    const controls = section.querySelector<HTMLElement>('[data-pagination-controls]');
    const pageNumbers = section.querySelector<HTMLElement>('[data-page-numbers]');
    const summary = section.querySelector<HTMLElement>('[data-page-summary]');
    const previous = section.querySelector<HTMLButtonElement>('[data-page-action="previous"]');
    const next = section.querySelector<HTMLButtonElement>('[data-page-action="next"]');
    const pageCount = Math.ceil(rows.length / pageSize);
    let currentPage = 1;

    if (!controls || !pageNumbers || !summary || !previous || !next || pageCount <= 1) return;

    const pageButtons: HTMLButtonElement[] = [];
    for (let page = 1; page <= pageCount; page += 1) {
      const button = document.createElement('button');
      button.type = 'button';
      button.textContent = String(page);
      button.dataset.page = String(page);
      button.setAttribute('aria-label', `第 ${page} 页`);
      pageNumbers.append(button);
      pageButtons.push(button);
    }

    const render = () => {
      rows.forEach((row, index) => {
        row.hidden = index < (currentPage - 1) * pageSize || index >= currentPage * pageSize;
      });

      previous.disabled = currentPage === 1;
      next.disabled = currentPage === pageCount;
      summary.textContent = `第 ${currentPage} / ${pageCount} 页，共 ${rows.length} 条`;
      pageButtons.forEach((button) => {
        if (Number(button.dataset.page) === currentPage) button.setAttribute('aria-current', 'page');
        else button.removeAttribute('aria-current');
      });
    };

    controls.hidden = false;
    controls.addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('button');
      if (!button || button.disabled) return;

      if (button.dataset.pageAction === 'previous') currentPage -= 1;
      if (button.dataset.pageAction === 'next') currentPage += 1;
      if (button.dataset.page) currentPage = Number(button.dataset.page);
      render();
      if (button.disabled) pageButtons[currentPage - 1].focus();
    });
    render();
  });
</script>
