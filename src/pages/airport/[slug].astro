---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { airports, getMaxDownload } from '../../data/airport-data';
export function getStaticPaths() { return airports.map((airport) => ({ params: { slug: airport.slug }, props: { airport } })); }
const { airport: a } = Astro.props;
const testCount = a.tests?.length ?? 0;
const qualitySampleCount = a.networkQualitySamples?.length ?? 0;
const nodeSnapshotCount = a.nodeSnapshots?.length ?? 0;
const serviceIncidentCount = a.serviceIncidents?.length ?? 0;
const verifiedTestSampleCount = testCount + qualitySampleCount;
const operationalObservationCount = nodeSnapshotCount + serviceIncidentCount;
const monitoringCopy = a.dataDays === 0
  ? '尚无实测样本，暂不参与正式排名。'
  : a.rankingEligible
    ? '评分来自达到最低样本要求后的滚动测试数据。'
    : `当前累计 ${a.dataDays} 天样本，达到至少 7 天、28 条已验证测速样本后再评估正式评分。`;
const testHeading = a.dataDays === 0 ? '等待首次实测' : `${a.dataDays} 天累计实测`;
const withoutTrailingPunctuation = (value: string) => value.replace(/[。；;，,\s]+$/u, '');
const formatFoundedAt = (value: string) => {
  const [year, month, day] = value.split('-');
  if (!month) return `${year} 年`;
  return day ? `${year} 年 ${Number(month)} 月 ${Number(day)} 日` : `${year} 年 ${Number(month)} 月`;
};
---
<html lang="zh-CN">
<head><BaseHead title={`${a.name}机场评测`} description={a.summary} /></head>
<body><Header /><main class="shell">
  <div class="page-head">
    <div class="section-kicker">DATA DAY {a.dataDays ?? '—'} · UPDATED {a.updated}</div>
    <h1>{a.name}机场评测</h1><p>{a.summary}</p>
    {a.website && <div class="actions"><a class="button" href={a.website} target="_blank" rel="nofollow sponsored noopener">访问官方网站 →</a></div>}
  </div>
  <div class="cards">
    <section class="card"><div class="card-top"><h2>基本信息</h2><strong class="score">{a.score ?? '数据积累中'}</strong></div>
      <p>运营状态：<span class="yes">{a.status}</span></p>
      {a.serviceStatus && <p>当前服务状态：<strong>{a.serviceStatus}</strong>{a.serviceStatusUpdated && <small>（更新 {a.serviceStatusUpdated}）</small>}</p>}
      {a.foundedAt && <p>成立时间：{formatFoundedAt(a.foundedAt)}</p>}
      {a.testClient && <p>测试客户端：{a.testClient}</p>}
      {a.platforms && <p>支持平台：{a.platforms.join('、')}</p>}{a.deviceLimit && <p>设备限制：{a.deviceLimit}</p>}
      <p class="desc">{monitoringCopy}</p>
    </section>
    <section class="card"><h2>入门套餐</h2><p>¥{a.price}/月 · {a.traffic}</p><p>协议：{a.protocol}</p>
      {a.couponCode && <p>优惠码：<strong class="score">{a.couponCode}</strong></p>}{a.registrationOffer && <p class="desc">{a.registrationOffer}</p>}
    </section>
    <section class="card"><h2>{testHeading}</h2>{verifiedTestSampleCount > 0 ? <>
	      <p><strong>{verifiedTestSampleCount}</strong> 条已验证测速样本</p>
	      <p class="desc">原始测速 {testCount} 条 · 网络质量补充 {qualitySampleCount} 条</p>
	      <p>最高下载 <strong>{getMaxDownload(a)} Mbps</strong></p>
      {a.chatgptStatus && <p>ChatGPT：{a.chatgptStatus}{a.chatgptStatusUpdated && <small>（更新 {a.chatgptStatusUpdated}）</small>}</p>}
      {a.streamingStatus && <p>流媒体：<span class="yes">{a.streamingStatus}</span></p>}
      <p class="desc">{a.rankingEligible ? '当前数据已进入正式评分样本。' : '样本尚未达到评分门槛，不计算稳定率和综合评分。'}</p>
	      {operationalObservationCount > 0 && <p class="desc">另有 {operationalObservationCount} 条节点或服务观察，仅作运行记录，不计入评分门槛。</p>}
	    </> : <><p>尚未录入已验证测速样本</p>{operationalObservationCount > 0 && <p>{operationalObservationCount} 条节点或服务观察</p>}<p class="desc">运行观察不计入评分门槛，不使用历史结论生成新评分。</p></>}</section>
  </div>
  {(a.trial || a.universalSubscription || a.noExpiry) && <section class="section"><div class="section-head"><div><div class="section-kicker">Service terms</div><h2>试用与使用方式</h2></div></div><div class="cards">
    <section class="card"><h2>免费试用</h2><p>{a.trial ?? '待复核'}</p></section>
    <section class="card"><h2>订阅方式</h2><p>{a.universalSubscription ?? '待复核'}</p>{a.platforms && <p class="desc">{a.platforms.join('、')}</p>}{a.bandwidthPolicy && <p class="desc">{a.bandwidthPolicy}</p>}</section>
    <section class="card"><h2>不限时流量</h2><p>{a.noExpiry ?? '待复核'}</p>{a.paymentMethods && <p class="desc">支付：{a.paymentMethods.join('、')}</p>}</section>
  </div></section>}
  {testCount > 0 && <section class="section"><div class="section-head"><div><div class="section-kicker">Raw records</div><h2>原始测速记录</h2></div></div><div style="overflow-x:auto"><table class="data-table"><thead><tr><th>时间</th><th>节点</th><th>下载</th><th>上传</th><th>ChatGPT</th><th>流媒体</th><th>详情</th></tr></thead><tbody>{a.tests?.map(t => <tr><td>{t.testedAt}<br/>{t.time ?? '时间未记录'}</td><td class="airport-name">{t.node}</td><td>{t.downloadMbps} Mbps</td><td>{t.uploadMbps.toFixed(2)} Mbps</td><td class={t.chatgpt === '稳定' ? 'yes' : ''}>{t.chatgpt}{t.evidenceImage && <small><a class="text-link" href={t.evidenceImage} target="_blank" rel="noopener">截图证据 →</a>{t.evidenceNote && <> · {t.evidenceNote}</>}</small>}</td><td class="yes">{t.streaming}</td><td>{t.resultUrl ? <a class="text-link" href={t.resultUrl} target="_blank" rel="noopener nofollow">Speedtest →</a> : '链接未记录'}</td></tr>)}</tbody></table></div></section>}
  {a.networkQualitySamples && <section class="section"><div class="section-head"><div><div class="section-kicker">Network quality</div><h2>延迟与使用体验记录</h2></div></div><div style="overflow-x:auto"><table class="data-table"><thead><tr><th>日期</th><th>节点</th><th>延迟</th><th>ChatGPT</th><th>流媒体</th><th>速度</th><th>测速服务器</th></tr></thead><tbody>{a.networkQualitySamples.map(sample => <tr><td>{sample.testedAt}<br/>{sample.time ?? '时间未记录'}</td><td class="airport-name">{sample.node}<small>{sample.evidence}{sample.evidenceImage && <><br/><a class="text-link" href={sample.evidenceImage} target="_blank" rel="noopener">截图证据 →</a></>}</small></td><td>{sample.latencyMs} ms</td><td>{sample.chatgpt ?? '未复测'}</td><td>{sample.streaming ?? '未复测'}</td><td>↓ {sample.downloadMbps} / ↑ {sample.uploadMbps} Mbps</td><td>{sample.server}</td></tr>)}</tbody></table></div><p class="desc">补充记录来自 Speedtest 客户端截图，与上方分享链接测速不是同一次测试，因此单独展示；它计入已验证测速样本，但不计入“原始测速”数量。单次测试的抖动与丢包受测速服务器和瞬时线路影响较大，本站不再展示或用于评分。</p></section>}
  {a.nodeSnapshots && <section class="section"><div class="section-head"><div><div class="section-kicker">Node availability</div><h2>节点在线快照</h2></div></div><div style="overflow-x:auto"><table class="data-table"><thead><tr><th>采集时间</th><th>节点总数</th><th>可达</th><th>超时</th><th>高延迟</th><th>异常节点</th><th>截图证据</th></tr></thead><tbody>{a.nodeSnapshots.map(snapshot => <tr><td>{snapshot.capturedAt}<br/>{snapshot.time}</td><td>{snapshot.total}</td><td class="yes">{snapshot.reachable}</td><td>{snapshot.timeout}</td><td>{snapshot.highLatency}<small>{snapshot.latencyRange}</small></td><td><small>超时：{snapshot.timeoutNodes.length ? snapshot.timeoutNodes.join('、') : '无'}</small><small>高延迟：{snapshot.highLatencyNodes.length ? snapshot.highLatencyNodes.join('、') : '无'}</small><small>当前选择：{snapshot.selectedNode}</small></td><td>{snapshot.evidenceImages.map((image, index) => <a class="text-link" href={image} target="_blank" rel="noopener">截图 {index + 1} →<br/></a>)}</td></tr>)}</tbody></table></div><p class="desc">节点状态是指定时刻的客户端快照，仅反映当时可达性与客户端显示延迟，不等同于长期在线率。</p></section>}
  {a.serviceIncidents && <section class="section"><div class="section-head"><div><div class="section-kicker">Service incidents</div><h2>服务异常记录</h2></div></div><div style="overflow-x:auto"><table class="data-table"><thead><tr><th>观察时间</th><th>状态</th><th>测速</th><th>ChatGPT</th><th>流媒体</th></tr></thead><tbody>{a.serviceIncidents.map(incident => <tr><td>{incident.observedAt}<br/>{incident.time}</td><td>{incident.status}</td><td>{incident.speedtest}</td><td>{incident.chatgpt}</td><td>{incident.streaming}<small>{incident.note}</small></td></tr>)}</tbody></table></div></section>}
  {a.plans && <section class="section"><div class="section-head"><div><div class="section-kicker">Plans</div><h2>套餐与流量</h2></div></div><div style="overflow-x:auto"><table class="data-table"><thead><tr><th>套餐</th><th>价格</th><th>流量</th><th>主要规则</th></tr></thead><tbody>{a.plans.map(p => <tr><td class="airport-name">{p.name}</td><td>{p.price}</td><td>{p.traffic}</td><td>{p.details?.join('；') ?? '以套餐页实时说明为准'}</td></tr>)}</tbody></table></div>{a.billingPolicy && <p class="desc">付费周期：{a.billingPolicy}</p>}{a.planEvidenceImages && <p class="desc">套餐截图证据：{a.planEvidenceImages.map((image, index) => <><a class="text-link" href={image} target="_blank" rel="noopener">截图 {index + 1} →</a>{index < a.planEvidenceImages!.length - 1 ? ' · ' : ''}</>)}</p>}</section>}
  {a.noExpiryPlans && <section class="section"><div class="section-head"><div><div class="section-kicker">No-expiry plans</div><h2>不限时流量套餐</h2></div></div><div style="overflow-x:auto"><table class="data-table"><thead><tr><th>套餐</th><th>价格</th><th>流量与有效期</th><th>主要规则</th></tr></thead><tbody>{a.noExpiryPlans.map(p => <tr><td class="airport-name">{p.name}</td><td>{p.price}</td><td>{p.traffic}</td><td>{p.details?.join('；') ?? '以套餐页实时说明为准'}</td></tr>)}</tbody></table></div>{a.billingPolicy && <p class="desc">套餐规则：{a.billingPolicy}</p>}{a.planEvidenceImages && <p class="desc">套餐截图证据：{a.planEvidenceImages.map((image, index) => <><a class="text-link" href={image} target="_blank" rel="noopener">截图 {index + 1} →</a>{index < a.planEvidenceImages!.length - 1 ? ' · ' : ''}</>)}</p>}</section>}
  {a.dailyPlans && <section class="section"><div class="section-head"><div><div class="section-kicker">Daily quota plans</div><h2>每日独立流量套餐</h2></div></div><div style="overflow-x:auto"><table class="data-table"><thead><tr><th>套餐</th><th>价格</th><th>有效期</th><th>流量规则</th></tr></thead><tbody>{a.dailyPlans.map(p => <tr><td class="airport-name">{p.name}</td><td>{p.price}</td><td>{p.duration}</td><td>{p.traffic}</td></tr>)}</tbody></table></div></section>}
  {a.addOns && <section class="section"><div class="section-head"><div><div class="section-kicker">Traffic add-ons</div><h2>流量加油包</h2></div></div><div style="overflow-x:auto"><table class="data-table"><thead><tr><th>加油包</th><th>价格</th><th>增加流量</th><th>使用条件</th></tr></thead><tbody>{a.addOns.map(item => <tr><td class="airport-name">{item.name}</td><td>{item.price}</td><td>{item.traffic}</td><td>{item.condition}</td></tr>)}</tbody></table></div></section>}
  {a.regions && <section class="section"><div class="section-head"><div><div class="section-kicker">Network</div><h2>节点与使用条件</h2></div></div><div class="cards">
	    <section class="card"><h2>节点覆盖</h2>{a.nodeCount ? <p>{a.nodeCount} 个节点</p> : <p>节点数量待复核</p>}<p>{a.regions.join('、')}</p>{a.onlineSnapshot && <p class="desc">{withoutTrailingPunctuation(a.onlineSnapshot)}。这是带日期的后台快照，不代表长期在线率。</p>}{a.regionsNote && <p class="desc">{a.regionsNote}</p>}</section>
    <section class="card"><h2>线路与订阅</h2><p>{a.lineTypes?.join(' / ') ?? '线路待复核'} · {a.protocol}</p>{a.universalSubscription && <p>{a.universalSubscription}</p>}{a.bandwidthPolicy && <p class="desc">{a.bandwidthPolicy}</p>}</section>
    <section class="card"><h2>支付与售后</h2><p>{a.paymentMethods?.join('、') ?? '支付方式待复核'}</p>{a.refundPolicy && <p class="desc">{a.refundPolicy}</p>}{a.supportResponse && <p class="desc">客服响应样本：{a.supportResponse}</p>}{a.supportUrl && <a class="text-link" href={a.supportUrl} target="_blank" rel="noopener nofollow">{a.supportChannel} →</a>}</section>
  </div></section>}
</main><Footer /></body></html>
