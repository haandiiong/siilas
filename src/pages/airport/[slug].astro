---
import TestedAirportPage from '../../components/TestedAirportPage.astro';
import AirportProfilePage from '../../components/AirportProfilePage.astro';
import { airports } from '../../data/airport-data';
import { airportProfiles } from '../../data/airport-profiles';

export function getStaticPaths() {
  const testedSlugs = new Set(airports.map((airport) => airport.slug));
  const duplicate = airportProfiles.find((profile) => testedSlugs.has(profile.slug));
  if (duplicate) throw new Error(`资料页与实测页 slug 冲突：${duplicate.slug}`);
  return [
    ...airports.map((airport) => ({ params: { slug: airport.slug }, props: { kind: 'tested', airport } })),
    ...airportProfiles.map((profile) => ({ params: { slug: profile.slug }, props: { kind: 'profile', profile } })),
  ];
}

const { kind, airport, profile } = Astro.props;
---
{kind === 'tested' ? <TestedAirportPage airport={airport!} /> : <AirportProfilePage profile={profile!} />}
