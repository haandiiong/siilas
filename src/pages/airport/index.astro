---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { airports, getMaxDownload } from '../../data/airport-data';
---
<html lang="zh-CN"><head><BaseHead title="机场数据库" description="Siilas 机场评测数据库，查看价格、流量、速度和稳定性。" /></head><body><Header /><main class="shell"><div class="page-head"><div class="section-kicker">Airport database</div><h1>机场数据库</h1><p>所有评分来自滚动测试样本。点击服务查看详细指标、适合人群和历史记录。</p></div><div class="cards">{airports.map((airport) => <a class="card" href={`/airport/${airport.slug}/`}><div class="card-top"><h2>{airport.name}</h2><strong class="score">{airport.score ?? '积累中'}</strong></div><p class="desc">{airport.summary}</p><div class="stats"><div><small>稳定性</small><b>{airport.stability === null ? '样本不足' : `${airport.stability}%`}</b></div><div><small>最高速度</small><b>{getMaxDownload(airport) === null ? '待实测' : `${getMaxDownload(airport)} Mbps`}</b></div><div><small>起步价格</small><b>¥{airport.price}/月</b></div><div><small>流量</small><b>{airport.traffic}</b></div></div></a>)}</div></main><Footer /></body></html>
