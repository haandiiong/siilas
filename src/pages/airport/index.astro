---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { airports } from '../../data/airport-data';
import { airportProfiles } from '../../data/airport-profiles';

const referenceProfiles = airportProfiles.filter((profile) => profile.status === 'reference')
  .sort((left, right) => right.sourceReviewedAt.localeCompare(left.sourceReviewedAt) || left.name.localeCompare(right.name, 'zh-CN'));
const riskProfiles = airportProfiles.filter((profile) => profile.status === 'stopped');
---
<html lang="zh-CN"><head><BaseHead title="机场数据库｜实测评测与机场资料" description={`Siilas 机场数据库收录 ${airports.length} 家有原始测速的机场，以及 ${referenceProfiles.length} 家来自 yp7.net 的套餐与客户端资料页。实测评分与来源资料分开呈现。`} /></head><body><Header /><main class="shell">
  <div class="page-head"><div class="section-kicker">Airport database</div><h1>机场数据库</h1><p>实测页展示本站原始测速与评分；资料页整理标注日期的套餐、试用和客户端条件，尚无本站独立测速。</p><div class="actions"><a class="button secondary" href="#tested">本站实测 · {airports.length} 家</a><a class="button secondary" href="#reference">来源资料 · {referenceProfiles.length} 家</a><a class="button secondary" href="/rank/">查看实测排行榜</a></div></div>

  <section class="section" id="tested"><div class="section-head"><div><div class="section-kicker">Tested by Siilas</div><h2>本站实测</h2></div><a class="text-link" href="/methodology/">评分方法 →</a></div><p class="desc">评分仅使用保留结果链接或截图的原始测速；样本不足的机场暂不生成综合评分。</p><div class="cards">{airports.map((airport) => <a class="card" href={`/airport/${airport.slug}/`}><div class="card-top"><h2>{airport.name}</h2><strong class="score">{airport.score ?? '样本不足'}</strong></div><p class="desc">{airport.summary}</p><div class="stats"><div><small>稳定性</small><b>{airport.stability === null ? '样本不足' : `${airport.stability}%`}</b></div><div><small>已验证样本</small><b>{airport.verifiedTestCount} 条</b></div><div><small>最低套餐</small><b>{airport.entryPlan.price}</b></div><div><small>套餐流量</small><b>{airport.entryPlan.traffic}</b></div></div></a>)}</div></section>

  <section class="section" id="reference"><div class="section-head"><div><div class="section-kicker">Source profiles</div><h2>机场资料页</h2></div></div><p class="desc">以下资料取自 yp7.net 项目，展示来源核对日期和购买限制。它们没有 Siilas 独立测速，不参与实测排行榜。</p><div class="cards profile-cards">{referenceProfiles.map((profile) => <a class="card" href={`/airport/${profile.slug}/`}><div class="card-top"><h2>{profile.name}</h2><strong class="score">资料页</strong></div><p>{profile.priceSummary}</p><p class="desc">试用：{profile.trial} · 客户端：{profile.client}</p><div class="stats"><div><small>通用订阅</small><b>{profile.universalSubscription}</b></div><div><small>不限时套餐</small><b>{profile.noExpiry}</b></div><div><small>来源核对</small><b>{profile.sourceReviewedAt}</b></div><div><small>本站测速</small><b>暂无</b></div></div></a>)}</div></section>

  {riskProfiles.length > 0 && <section class="section" id="risk"><div class="section-head"><div><div class="section-kicker">Risk records</div><h2>停止推荐记录</h2></div></div><div class="cards">{riskProfiles.map((profile) => <a class="card" href={`/airport/${profile.slug}/`}><div class="card-top"><h2>{profile.name}</h2><strong class="score">停止推荐</strong></div><p>{profile.cautions}</p><p class="desc">来源更新：{profile.sourceUpdatedAt} · 历史套餐不作为当前报价。</p></a>)}</div></section>}
</main><Footer /></body></html>
