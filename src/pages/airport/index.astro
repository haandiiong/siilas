---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { airports, getNetworkQualitySamples, getTests } from '../../data/airport-data';
---
<html lang="zh-CN"><head><BaseHead title="机场数据库｜价格、流量、速度与稳定性" description="浏览 Siilas 机场评测数据库，比较各机场最低套餐、流量、协议、节点速度、稳定性、ChatGPT 与流媒体体验，并查看历史测速证据。" /></head><body><Header /><main class="shell"><div class="page-head"><div class="section-kicker">Airport database</div><h1>机场数据库</h1><p>所有评分来自滚动测试样本。点击服务查看详细指标、适合人群和历史记录。</p><div class="actions"><a class="button secondary" href="/rank/">查看机场排行榜</a><a class="button secondary" href="/methodology/">了解评分方法</a></div></div><div class="cards">{airports.map((airport) => <a class="card" href={`/airport/${airport.slug}/`}><div class="card-top"><h2>{airport.name}</h2><strong class="score">{airport.score ?? '积累中'}</strong></div><p class="desc">{airport.summary}</p><div class="stats"><div><small>稳定性</small><b>{airport.stability === null ? '样本不足' : `${airport.stability}%`}</b></div><div><small>已验证样本</small><b>{getTests(airport).length + getNetworkQualitySamples(airport).length} 条</b></div><div><small>最低套餐</small><b>{airport.entryPlan.price}</b></div><div><small>套餐流量</small><b>{airport.entryPlan.traffic}</b></div></div></a>)}</div></main><Footer /></body></html>
