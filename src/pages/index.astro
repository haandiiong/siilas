---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { airports, getTests } from '../data/airport-data';
import { SITE_DESCRIPTION } from '../consts';

const siteTests = airports.flatMap((airport) => getTests(airport)
	.map((test) => ({ airport: airport.slug, testedAt: test.testedAt })));
const siteQualitySamples = airports.flatMap((airport) => (airport.networkQualitySamples ?? [])
	.map((sample) => ({ airport: airport.slug, testedAt: sample.testedAt })));
const testedAirportCount = new Set(siteTests.map((test) => test.airport)).size;
const longestSampleCoverage = Math.max(...airports.map((airport) => airport.dataDays), 0);
---
<!doctype html>
<html lang="zh-CN"><head><BaseHead description={SITE_DESCRIPTION} /></head><body><Header /><main>
	<section class="hero shell">
		<div><div class="eyebrow">Independent network intelligence · Since 2026</div><h1>机场推荐：看见节点在<br /><em>真实使用中的表现（长期实测更新）</em></h1><p class="lead">Siilas 持续记录主流机场的速度、稳定性、流媒体与 AI 服务可用性。少一点推荐话术，多一点可复查的数据，为翻墙机场推荐选择与科学上网配置提供真实参考。</p><div class="actions"><a class="button" href="/rank/">查看机场排行榜 →</a><a class="button secondary" href="/test/">浏览测速记录</a></div></div>
		<aside class="live-card"><div class="live-head"><span>本站测试数据</span><span class="pulse">持续监测</span></div><div class="big-number">{siteTests.length}<span style="font-size:20px;color:var(--muted)"> 次</span></div><p>来自 {testedAirportCount} 个机场的 Speedtest 原始测速</p><div class="mini-grid"><div class="mini"><b>{siteTests.length}</b><span>原始测速</span></div><div class="mini"><b>{siteQualitySamples.length}</b><span>质量补充样本</span></div><div class="mini"><b>{testedAirportCount}</b><span>已实测机场</span></div><div class="mini"><b>{longestSampleCoverage > 0 ? `${longestSampleCoverage} 天` : '待开始'}</b><span>最多样本日期</span></div></div></aside>
	</section>
	<section class="section shell"><div class="section-head"><div><div class="section-kicker">Rolling observations</div><h2>机场实测数据</h2></div><a class="text-link" href="/rank/">查看排行状态 →</a></div><div class="table-scroll"><table class="data-table"><caption class="sr-only">机场测试与数据状态</caption><thead><tr><th>机场</th><th>综合评分</th><th>稳定性</th><th>最低套餐</th><th>ChatGPT 分</th><th>流媒体分</th></tr></thead><tbody>{airports.map((airport) => <tr><td><a class="airport-name" href={`/airport/${airport.slug}/`}>{airport.name}<small>{airport.status} · 更新 {airport.updated.slice(5)}</small></a></td><td class="score">{airport.score ?? '积累中'}</td><td>{airport.stability === null ? '样本不足' : `${airport.stability}%`}</td><td><strong>{airport.entryPlan.price}</strong><small>{airport.entryPlan.traffic}</small></td><td>{airport.experienceScores.chatgpt === null ? '待测试' : <span class="score">{airport.experienceScores.chatgpt}</span>}</td><td>{airport.experienceScores.streaming === null ? '待测试' : <span class="score">{airport.experienceScores.streaming}</span>}</td></tr>)}</tbody></table></div></section>
	<section class="section shell"><div class="section-head"><div><div class="section-kicker">Transparent methodology</div><h2>数据是怎么来的</h2></div><a class="text-link" href="/methodology/">查看完整方法 →</a></div><div class="method-grid"><div class="method"><span>测试时段</span><b>全天不定时</b></div><div class="method"><span>测试环境</span><b>1000M 本地宽带</b></div><div class="method"><span>原始证据</span><b>测速截图与结果链接</b></div><div class="method"><span>测试客户端</span><b>专属客户端 / FlClash</b></div></div></section>
	<section class="section shell"><div class="section-head"><div><div class="section-kicker">Explore Siilas</div><h2>不止是一张推荐榜</h2></div></div><div class="feature-grid"><a class="feature" href="/airport/"><span class="num">01 / DATABASE</span><h3>机场数据库</h3><p>价格、协议、流量与长期表现集中归档。</p></a><a class="feature" href="/test/"><span class="num">02 / SPEED TEST</span><h3>测速中心</h3><p>保留每次测试的时间、速度和服务可用性。</p></a><a class="feature" href="/rank/"><span class="num">03 / RANKING</span><h3>分类排行榜</h3><p>样本充分后按稳定性、AI、流媒体和价格比较。</p></a><a class="feature" href="/tutorial/"><span class="num">04 / GUIDES</span><h3>实用教程</h3><p>从订阅配置到故障排查的清晰指南。</p></a></div></section>
</main><Footer /></body></html>
