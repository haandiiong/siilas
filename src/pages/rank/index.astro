---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { airports, getNetworkQualitySamples, getTests } from '../../data/airport-data';
const rankedAirports = [...airports].sort((a, b) => (b.score ?? -1) - (a.score ?? -1));
const eligibleRanks = new Map(rankedAirports.filter((airport) => airport.rankingEligible).map((airport, index) => [airport.slug, index + 1]));
---
<html lang="zh-CN"><head><BaseHead title="机场排行榜" description="基于持续测速的机场综合排行榜。" /></head><body><Header /><main class="shell"><div class="page-head"><div class="section-kicker">Data ranking</div><h1>机场排行榜</h1><p>综合评分同时考虑速度、稳定性、ChatGPT 与流媒体实测表现；样本不足的服务暂不参与正式排名。</p></div><div class="table-scroll"><table class="data-table" style="margin-bottom:80px"><caption class="sr-only">机场排名及数据积累状态</caption><thead><tr><th>排名</th><th>机场</th><th>评分</th><th>稳定性</th><th>已验证样本</th><th>最低套餐</th></tr></thead><tbody>{rankedAirports.map((airport) => <tr><td>{airport.rankingEligible ? `#${eligibleRanks.get(airport.slug)}` : '观察'}</td><td><a class="airport-name" href={`/airport/${airport.slug}/`}>{airport.name}</a></td><td class="score">{airport.score ?? '积累中'}</td><td>{airport.stability === null ? '样本不足' : `${airport.stability}%`}</td><td>{getTests(airport).length + getNetworkQualitySamples(airport).length} 条</td><td><strong>{airport.entryPlan.price}</strong><small>{airport.entryPlan.traffic}</small></td></tr>)}</tbody></table></div></main><Footer /></body></html>
