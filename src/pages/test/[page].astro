---
import type { GetStaticPaths } from 'astro';
import TestArchivePage from '../../components/TestArchivePage.astro';
import { archivePageCount } from '../../data/test-archive';

export const prerender = true;
export const getStaticPaths = (() => Array.from({ length: archivePageCount - 1 }, (_, index) => ({
	params: { page: String(index + 2) },
	props: { currentPage: index + 2 },
}))) satisfies GetStaticPaths;

interface Props { currentPage: number; }
const { currentPage } = Astro.props;
---
<TestArchivePage currentPage={currentPage} />
