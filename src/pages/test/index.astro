---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { AUTHOR_DESCRIPTION, AUTHOR_NAME, TEST_CLIENTS, TEST_DEVICE, TEST_NETWORK } from '../../consts';
import { airports, getTests } from '../../data/airport-data';
const records = airports
	.flatMap((airport) => getTests(airport).map((test) => ({ airport: airport.name, airportSlug: airport.slug, ...test })))
	.sort((a, b) => `${b.testedAt} ${b.time ?? ''}`.localeCompare(`${a.testedAt} ${a.time ?? ''}`));
const testedAirportCount = new Set(records.map((record) => record.airport)).size;
const verifiedTestCount = airports.reduce((count, airport) => count + airport.verifiedTestCount, 0);
const recordDates = records.map((record) => record.testedAt).sort();
const testDescription = `浏览 Siilas ${testedAirportCount} 家机场的 ${verifiedTestCount} 条已验证测速，复查节点速度、ChatGPT 与流媒体体验。`;
const testUrl = new URL('/test/', Astro.site).href;
const authorUrl = new URL('/about/', Astro.site).href;
const testStructuredData = {
	'@context': 'https://schema.org',
	'@type': 'Dataset',
	name: 'Siilas 机场测速与使用体验数据集',
	description: testDescription,
	url: testUrl,
	inLanguage: 'zh-CN',
	creator: {
		'@type': 'Person',
		'@id': `${authorUrl}#person`,
		name: AUTHOR_NAME,
		description: AUTHOR_DESCRIPTION,
		url: authorUrl,
	},
	dateModified: recordDates.at(-1),
	...(recordDates.length ? { temporalCoverage: `${recordDates[0]}/${recordDates.at(-1)}` } : {}),
	spatialCoverage: ['香港', '日本', '新加坡', '美国'],
	measurementTechnique: `${TEST_NETWORK}、${TEST_DEVICE}、${TEST_CLIENTS}、Speedtest、ChatGPT 实际问答与 4K 流媒体播放测试`,
	variableMeasured: ['下载速度 Mbps', '上传速度 Mbps', '节点延迟 ms', 'ChatGPT 首字响应体验', '4K 流媒体缓冲体验'],
	additionalProperty: [
		{ '@type': 'PropertyValue', name: '已验证测速样本数量', value: verifiedTestCount, unitText: '条' },
	],
	isAccessibleForFree: true,
	keywords: ['机场测速', '机场评测', '节点速度', 'ChatGPT 节点', '流媒体解锁'],
};
---
<html lang="zh-CN"><head><BaseHead title="机场测速记录｜四地区节点与使用体验" description={testDescription} structuredData={testStructuredData} /></head><body><Header /><main class="shell">
	<div class="page-head"><div class="section-kicker">Speed test archive</div><h1>测速中心</h1><p>当前共监测 {testedAirportCount} 家机场，收录 {verifiedTestCount} 条已验证测速，全部参与评分与日期统计。</p><p class="desc">每条记录保留 Speedtest 结果链接或截图；未提供的指标不会使用估算值。</p><div class="actions"><a class="button secondary" href="/rank/">查看机场排行榜</a><a class="button secondary" href="/methodology/">了解测试方法</a></div></div>
	<section data-archive-pagination data-page-size="10">
		<div style="overflow-x:auto"><table class="data-table"><caption class="sr-only">机场测速原始记录</caption><thead><tr><th>时间</th><th>服务 / 节点</th><th>下载</th><th>上传</th><th>ChatGPT</th><th>流媒体</th><th>详情</th></tr></thead><tbody>{records.map((record) => <tr data-page-row><td>{record.testedAt}<br />{record.time ?? '未记录'}</td><td class="airport-name"><a href={`/airport/${record.airportSlug}/`}>{record.airport}</a><small>{record.node}</small></td><td>{record.downloadMbps} Mbps</td><td>{record.uploadMbps.toFixed(2)} Mbps</td><td>{record.chatgpt}</td><td>{record.streaming}</td><td>{record.resultUrl ? <a class="text-link" href={record.resultUrl} target="_blank" rel="noopener nofollow">Speedtest →</a> : '链接未记录'}</td></tr>)}</tbody></table></div>
		<nav class="table-pagination" data-pagination-controls hidden aria-label="测速原始记录分页"><button type="button" data-page-action="previous">上一页</button><span class="page-numbers" data-page-numbers></span><button type="button" data-page-action="next">下一页</button><span class="page-summary" data-page-summary aria-live="polite"></span></nav>
	</section>
</main><Footer /></body></html>

<script>
	document.querySelectorAll<HTMLElement>('[data-archive-pagination]').forEach((section) => {
		const rows = Array.from(section.querySelectorAll<HTMLTableRowElement>('[data-page-row]'));
		const controls = section.querySelector<HTMLElement>('[data-pagination-controls]');
		const pageNumbers = section.querySelector<HTMLElement>('[data-page-numbers]');
		const summary = section.querySelector<HTMLElement>('[data-page-summary]');
		const previous = section.querySelector<HTMLButtonElement>('[data-page-action="previous"]');
		const next = section.querySelector<HTMLButtonElement>('[data-page-action="next"]');
		const pageSize = Number(section.dataset.pageSize) || 10;
		const pageCount = Math.ceil(rows.length / pageSize);
		let currentPage = 1;

		if (!controls || !pageNumbers || !summary || !previous || !next || pageCount <= 1) return;

		const render = () => {
			rows.forEach((row, index) => {
				row.hidden = index < (currentPage - 1) * pageSize || index >= currentPage * pageSize;
			});
			previous.disabled = currentPage === 1;
			next.disabled = currentPage === pageCount;
			summary.textContent = `第 ${currentPage} / ${pageCount} 页，共 ${rows.length} 条`;
			pageNumbers.replaceChildren();
			for (let page = 1; page <= pageCount; page += 1) {
				const button = document.createElement('button');
				button.type = 'button';
				button.textContent = String(page);
				button.dataset.page = String(page);
				button.setAttribute('aria-label', `第 ${page} 页`);
				if (page === currentPage) button.setAttribute('aria-current', 'page');
				pageNumbers.append(button);
			}
		};

		controls.hidden = false;
		controls.addEventListener('click', (event) => {
			const button = (event.target as Element).closest<HTMLButtonElement>('button');
			if (!button || button.disabled) return;
			if (button.dataset.pageAction === 'previous') currentPage -= 1;
			if (button.dataset.pageAction === 'next') currentPage += 1;
			if (button.dataset.page) currentPage = Number(button.dataset.page);
			render();
		});
		render();
	});
</script>
