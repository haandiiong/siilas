---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { airports, getNetworkQualitySamples, getTests } from '../../data/airport-data';
const records = airports
	.flatMap((airport) => getTests(airport).map((test) => ({ airport: airport.name, ...test })))
	.sort((a, b) => `${b.testedAt} ${b.time ?? ''}`.localeCompare(`${a.testedAt} ${a.time ?? ''}`));
const qualityRecords = airports
	.flatMap((airport) => getNetworkQualitySamples(airport).map((sample) => ({ airport: airport.name, ...sample })))
	.sort((a, b) => `${b.testedAt} ${b.time ?? ''}`.localeCompare(`${a.testedAt} ${a.time ?? ''}`));
const testedAirportCount = new Set([...records, ...qualityRecords].map((record) => record.airport)).size;
const totalRecordCount = records.length + qualityRecords.length;
---
<html lang="zh-CN"><head><BaseHead title="测速中心" description="Siilas 机场测速原始记录。" /></head><body><Header /><main class="shell">
	<div class="page-head"><div class="section-kicker">Speed test archive</div><h1>测速中心</h1><p>当前共监测 {testedAirportCount} 家机场，累计 {totalRecordCount} 条真实记录。未提供的指标不会使用估算值。</p></div>
	<div style="overflow-x:auto"><table class="data-table" style="margin-bottom:80px"><caption class="sr-only">机场测速原始记录</caption><thead><tr><th>时间</th><th>服务 / 节点</th><th>下载</th><th>上传</th><th>ChatGPT</th><th>流媒体</th><th>详情</th></tr></thead><tbody>{records.map((record) => <tr><td>{record.testedAt}<br />{record.time ?? '未记录'}</td><td class="airport-name">{record.airport}<small>{record.node}</small></td><td>{record.downloadMbps} Mbps</td><td>{record.uploadMbps.toFixed(2)} Mbps</td><td>{record.chatgpt}</td><td>{record.streaming}</td><td>{record.resultUrl ? <a class="text-link" href={record.resultUrl} target="_blank" rel="noopener nofollow">Speedtest →</a> : '链接未记录'}</td></tr>)}</tbody></table></div>
	{qualityRecords.length > 0 && <section class="section"><div class="section-head"><div><div class="section-kicker">Network quality</div><h2>延迟、抖动与丢包记录</h2></div></div><div style="overflow-x:auto"><table class="data-table"><caption class="sr-only">网络质量补充记录</caption><thead><tr><th>日期</th><th>服务 / 节点</th><th>延迟</th><th>抖动</th><th>丢包</th><th>ChatGPT</th><th>流媒体</th><th>下载 / 上传</th><th>服务器</th></tr></thead><tbody>{qualityRecords.map((record) => <tr><td>{record.testedAt}<br />{record.time ?? '未记录'}</td><td class="airport-name">{record.airport}<small>{record.node}</small></td><td>{record.latencyMs} ms</td><td>{record.jitterMs} ms</td><td>{record.packetLossPercent === null ? '未记录' : `${record.packetLossPercent}%`}</td><td>{record.chatgpt ?? '未复测'}</td><td>{record.streaming ?? '未复测'}</td><td>↓ {record.downloadMbps} / ↑ {record.uploadMbps} Mbps</td><td>{record.server}</td></tr>)}</tbody></table></div></section>}
</main><Footer /></body></html>
